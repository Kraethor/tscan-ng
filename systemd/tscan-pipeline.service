[Unit]
Description=tscan-ng fan-out capture+detect pipeline
After=network.target
Documentation=file:/opt/tscan/docs/REBUILD.md
# Unlimited restart attempts. The default (5 starts per 10s) exists to stop
# a genuinely broken unit from spinning forever, but the main failure mode
# here -- the capture interface (a USB NIC) going down --
# is exactly the case where retrying forever is correct: every RestartSec
# tick is another chance to notice the NIC came back, and pipeline.py now
# exits non-zero specifically so these retries happen instead of the
# service just going quiet. Losing that safety valve is an acceptable
# trade given RestartSec=5 already keeps the retry rate low.
StartLimitIntervalSec=0

[Service]
Type=simple
User=tscan
Group=tscan
WorkingDirectory=/opt/tscan
ExecStart=/opt/tscan/venv/bin/python -m tscan_ng.pipeline
Restart=on-failure
RestartSec=5
SyslogIdentifier=tscan-pipeline

# /run/tscan, owned by tscan:tscan, created before ExecStart and removed on
# stop (but preserved across Restart= cycles within one activation). Used by
# tscan_ng/sinks/discord.py to coordinate the operational-alert cooldown
# across all pipeline_worker processes, which otherwise have no shared
# memory to dedupe through.
RuntimeDirectory=tscan

# /var/log/tscan holds results.jsonl, which contains captured credentials in
# the clear (TODO.md #6). systemd creates the directory if it is missing,
# makes it owned by tscan:tscan and resets it to 0750 on every start, so
# only tscan and members of the tscan group (your operator user, for
# watch.py and dashboard.py) can reach the files. UMask=0027 makes files the service
# creates 0640 (results.jsonl when it is first created, cooldown markers);
# logrotate renames the file (keeping its mode) and creates the new one
# 0640 tscan:tscan (logrotate/tscan, TODO.md #47).
# LogsDirectory also makes this path writable under ProtectSystem=strict
# below, so a non-default [output] out outside /var/log/tscan needs a
# ReadWritePaths= line here.
LogsDirectory=tscan
LogsDirectoryMode=0750
UMask=0027

# Replaces tscan-capture.service + tscan-dispatcher.service: each pipeline
# process now does its own raw AF_PACKET capture directly (joined to a
# shared PACKET_FANOUT_HASH group), so it needs the capture capabilities
# tscan-capture.service used to hold. Workers are started with multiprocessing's
# "spawn" method (a fresh interpreter per worker, pinned in pipeline.main());
# ambient capabilities survive that exec, so every pipeline_worker child
# inherits these from this parent process. SIGTERM (systemctl stop) makes each
# worker flush its pending sessions before exiting.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# Sandboxing (TODO.md #7). This process parses hostile network traffic with
# raw-socket capabilities, so limit what a compromise could do with it.
#   - The whole filesystem is read-only except the LogsDirectory and
#     RuntimeDirectory above. That matters because tscan owns /opt/tscan:
#     without it a compromised worker could rewrite the code that runs at the
#     next restart. Python silently skips writing __pycache__ there.
#   - The deploy key in /opt/tscan/.ssh is hidden; the pipeline never needs it.
#   - NoNewPrivileges does not affect the ambient capabilities above; they
#     are granted before exec and still survive the spawn workers' exec.
#   - AF_PACKET is capture; INET/INET6 are the Discord webhook and DNS;
#     UNIX is multiprocessing, journald and systemd-resolved; NETLINK is
#     getaddrinfo(). Anything else fails with EAFNOSUPPORT.
#   - The syscall filter returns EPERM rather than killing the process, so a
#     missed call shows up as an exception in the journal.
# Deliberately NOT set: PrivateUsers (capabilities would then only apply
# inside a user namespace, not to the host's network), PrivateNetwork /
# IPAddressDeny (capture and Discord need the host network) and
# MemoryDenyWriteExecute (can break ctypes, which compiles the BPF filter
# through libpcap). Check with: systemd-analyze security tscan-pipeline
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/opt/tscan/.ssh
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_PACKET AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Combined memory budget for capture+session-tracking+detection across all
# pipeline processes. Previously split across tscan-capture.service's 256M
# and tscan-dispatcher.service's 4G separately; this single service now
# does both jobs, so it adopts the larger of the two as its ceiling.
#
# Sized for a high-core-count host: workers=12 x capture.buffer_bytes=256M
# alone is ~3G of AF_PACKET recv-buffer allocation, leaving no headroom under
# the original 3G/4G limits sized for fewer workers. On a host with ample RAM
# (tens of GB) these were bumped proportionally; lower them for a smaller box.
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=512M

[Install]
WantedBy=multi-user.target
