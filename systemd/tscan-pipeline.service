[Unit]
Description=tscan-ng fan-out capture+detect pipeline
After=network.target
Documentation=file:/opt/tscan/docs/REBUILD.md
# Unlimited restart attempts. The default (5 starts per 10s) exists to stop
# a genuinely broken unit from spinning forever, but the main failure mode
# here -- the capture interface (enx00242788e34c, a USB NIC) going down --
# is exactly the case where retrying forever is correct: every RestartSec
# tick is another chance to notice the NIC came back, and pipeline.py now
# exits non-zero specifically so these retries happen instead of the
# service just going quiet. Losing that safety valve is an acceptable
# trade given RestartSec=5 already keeps the retry rate low.
StartLimitIntervalSec=0

[Service]
Type=simple
User=tscan
Group=tscan
WorkingDirectory=/opt/tscan
ExecStart=/opt/tscan/venv/bin/python -m tscan_ng.pipeline
Restart=on-failure
RestartSec=5
SyslogIdentifier=tscan-pipeline

# /run/tscan, owned by tscan:tscan, created before ExecStart and removed on
# stop (but preserved across Restart= cycles within one activation). Used by
# tscan_ng/sinks/discord.py to coordinate the operational-alert cooldown
# across all pipeline_worker processes, which otherwise have no shared
# memory to dedupe through.
RuntimeDirectory=tscan

# Replaces tscan-capture.service + tscan-dispatcher.service: each pipeline
# process now does its own raw AF_PACKET capture directly (joined to a
# shared PACKET_FANOUT_HASH group), so it needs the capture capabilities
# tscan-capture.service used to hold. multiprocessing's fork() preserves
# ambient capabilities across fork, so every pipeline_worker child inherits
# these from this parent process without re-exec.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# Combined memory budget for capture+session-tracking+detection across all
# pipeline processes. Previously split across tscan-capture.service's 256M
# and tscan-dispatcher.service's 4G separately; this single service now
# does both jobs, so it adopts the larger of the two as its ceiling.
#
# Raised 2026-07-13 on ser8: workers=12 (vs U01's smaller worker count) x
# capture.buffer_bytes=256M alone is ~3G of AF_PACKET recv-buffer allocation,
# leaving no headroom under the original 3G/4G limits sized for fewer
# workers. ser8 has 57G RAM, so bumped proportionally.
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=512M

[Install]
WantedBy=multi-user.target
