[Unit]
Description=tscan-ng pcap capture process
After=tscan-dispatcher.service
Requires=tscan-dispatcher.service
BindsTo=tscan-dispatcher.service
Documentation=file:/opt/tscan/docs/REBUILD.md

[Service]
Type=simple
User=tscan
Group=tscan
WorkingDirectory=/opt/tscan
ExecStart=/opt/tscan/venv/bin/python -m tscan_ng.capture
Restart=on-failure
RestartSec=5
SyslogIdentifier=tscan-capture
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# Baseline is ~8MB plus the 32MB kernel capture ring buffer
# (capture.buffer_bytes in tscan_ng.conf). This caps well above that
# while still containing any runaway to this cgroup instead of the
# whole system, matching tscan-dispatcher.service.
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M

[Install]
WantedBy=multi-user.target
